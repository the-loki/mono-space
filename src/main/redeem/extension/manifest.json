{
  "manifest_version": 3,
  "name": "MonoSpace store helper",
  "version": "1.0.0",
  "description": "在 Epic 兑换页 / Fab 库页执行单条兑换步骤并回执（MonoSpace 内置）。",
  "content_scripts": [
    {
      "matches": [
        "https://www.epicgames.com/account/code-redemption*",
        "https://www.fab.com/library*",
        "https://www.fab.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://www.epicgames.com/*",
    "https://www.fab.com/*"
  ]
}
