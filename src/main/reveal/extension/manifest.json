{
  "manifest_version": 3,
  "name": "MonoSpace Humble helper",
  "version": "1.0.0",
  "description": "在 humblebundle.com 页面上下文中执行只读查询与单条揭示（MonoSpace 内置）。",
  "content_scripts": [
    {
      "matches": ["https://www.humblebundle.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": ["https://www.humblebundle.com/*"]
}
